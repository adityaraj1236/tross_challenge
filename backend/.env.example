# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# --- LinkedIn session (required for authenticated profile access) ---------
# Obtain by logging into linkedin.com in your own browser, opening DevTools
# > Application > Cookies > https://www.linkedin.com, and copying the
# values below. These are YOUR OWN account's session credentials - do not
# share them, and rotate/remove them from your .env when done testing.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional: any additional cookies as "name=value; name2=value2"
LINKEDIN_EXTRA_COOKIES=
# Optional: override the default mobile Chrome user agent string.
# Changing this may lose LinkedIn's fuller server-rendered response - see
# README section 5 for why a mobile User-Agent is used by default.
LINKEDIN_USER_AGENT=

# --- HTTP behaviour against LinkedIn ---------------------------------------
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5

# --- Service -----------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
# Comma-separated list of allowed origins for the frontend, e.g.
# https://your-frontend.example.com. Use * only for local development.
CORS_ORIGINS=*
